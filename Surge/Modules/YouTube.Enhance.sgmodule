#!name=YouTube (Music) 增強模組
#!desc=適用於 YouTube 與 YouTube Music，僅修改 UI 與 API 回應
#!arguments=隱藏上傳按鈕:true,隱藏選段按鈕:true,隱藏Shorts按鈕:true,字幕翻譯語言:off,啟用除錯模式:false
#!arguments-desc=- 隱藏功能參數：[true, false] \n- 字幕翻譯語言：[Google Translate 語言代碼, off] \n\n1. 語言代碼請參照 Google Translate 語言代碼\n2. 填入 off 則關閉字幕翻譯功能\n3. 開啟除錯模式可輸出更多日誌資訊，用於問題排查\n\n# ==================================================================
# YouTube (Music) UI Enhancement
# ------------------------------------------------------------------
# 本模組僅修改 YouTube / YouTube Music 的 API Response。
#
# 功能：
#   - 隱藏上傳按鈕
#   - 隱藏選段按鈕
#   - 隱藏 Shorts
#   - 修改字幕翻譯語言
#   - Debug 除錯模式
#
# Script 採用本 repository 自行維護的版本：
#   Rule-Sets/Surge/Moudles/youtube.response.js
#
# 本模組不處理影片播放請求，因此不使用：
#   - youtube.request.js
#   - googlevideo.com/initplayback
#   - encryptedClientKey
#   - init-stream redirect
#   - log_event request
#
# ==================================================================

[Script]

# ------------------------------------------------------------------
# YouTube API Response
# ------------------------------------------------------------------
# 攔截 YouTube / YouTube Music API 回應，
# 並交由自託管的 youtube.response.js 進行 UI 修改。
#
# API：
#   browse
#   next
#   player
#   search
#   reel/reel_watch_sequence
#   guide
#   account/get_setting
#   get_watch
#   log_event
#   config
#
# requires-body=1
#   必須取得 Response Body，才能修改 API 回應內容。
#
# max-size=-1
#   不限制 Response Body 大小。
#
# binary-body-mode=1
#   使用 binary body 模式，配合 Script 處理。
# ------------------------------------------------------------------
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/cloverdefa/Rule-Sets/main/Surge/Moudles/youtube.response.js,argument="{\"captionLang\":\"{{{字幕翻譯語言}}}\",\"blockUpload\":{{{隱藏上傳按鈕}}},\"blockImmersive\":{{{隱藏選段按鈕}}},\"blockShorts\":{{{隱藏Shorts按鈕}}},\"debug\":{{{啟用除錯模式}}}}"


[MITM]

# ------------------------------------------------------------------
# YouTube API
# ------------------------------------------------------------------
# 純 UI 版本只需要攔截 youtubei.googleapis.com。
#
# 不需要 *.googlevideo.com，因為本模組不再攔截：
#   - initplayback
#   - 影片串流請求
#   - encryptedClientKey
#
# 因此可以縮小 MITM 範圍，避免不必要的 HTTPS 解密。
# ------------------------------------------------------------------
hostname = %APPEND% youtubei.googleapis.com

