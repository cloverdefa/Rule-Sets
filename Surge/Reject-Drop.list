# REPO: https://github.com/cloverdefa/Rule-Sets/Surge/Reject-Drop.list
# DOMAIN-SUFFIX: 0
# URL-REGEX: 5

# Line Voom
URL-REGEX,^https:\/\/legy\.line-apps\.com\/ext\/videohub\/.*$,REJECT
URL-REGEX,^https:\/\/legy\.line-apps\.com\/tl\/discover\/api\/v\d+\/recommendTab\/feeds$,REJECT
URL-REGEX,^https:\/\/legy\.line-apps\.com\/tl\/discover\/api\/v\d+\/collage\/searchEntry$,REJECT
URL-REGEX,^https:\/\/legy\.line-apps\.com\/tl\/api\/v\d+\/feed$,REJECT
URL-REGEX,^https:\/\/legy\.line-apps\.com\/tl\/api\/v\d+\/timeline\/.*$,REJECT

