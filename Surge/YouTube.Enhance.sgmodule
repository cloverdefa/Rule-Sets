#!name=YouTube (Music) 增強模組
#!desc=適用於 YouTube 與 YouTube Music
#!arguments=隱藏上傳按鈕:true,隱藏選段按鈕:true,隱藏Shorts按鈕:true,字幕翻譯語言:off,啟用除錯模式:false
#!arguments-desc=- 隱藏功能參數：[true, false] \n- 翻譯功能參數：[語言代碼, off] \n\n1. 語言代碼請參照 Google 翻譯語言代碼，填入 off 則關閉字幕翻譯功能\n2. 開啟除錯模式可用於輸出更多日誌資訊

[Script]
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,argument="{"captionLang":"{{{字幕翻譯語言}}}","blockUpload":{{{隱藏上傳按鈕}}},"blockImmersive":{{{隱藏選段按鈕}}},"blockShorts":{{{隱藏Shorts按鈕}}},"debug":{{{啟用除錯模式}}}}"
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,argument="{"captionLang":"{{{字幕翻譯語言}}}"}"
youtube.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js
[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
